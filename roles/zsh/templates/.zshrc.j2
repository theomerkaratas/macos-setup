# ====================
# MySQL CLI
# ====================

alias myr='mysql -u root -p'                          # connect to MySQL as root (asks for password)
alias mydbs='echo "SHOW DATABASES;" | mysql -u root -p'   # list all databases
alias myusers='echo "SELECT user,host FROM mysql.user;" | mysql -u root -p' # list all users
alias myver='mysql -V'                               # show MySQL version

alias mydump='mysqldump -u root -p'                  # export a database (usage: mydump dbname > backup.sql)
alias myimport='mysql -u root -p'                    # import a database (usage: myimport dbname < backup.sql)

alias mystart='brew services start mysql'            # start MySQL service
alias mystop='brew services stop mysql'              # stop MySQL service
alias myrestart='brew services restart mysql'        # restart MySQL service
alias mystatus='brew services list | grep mysql'     # check MySQL service status

# ====================
# cURL (general)
# ====================
alias cj='curl -sS'                                         # curl: silent (no progress) but show errors
alias cjH='curl -sS -H "Content-Type: application/json"'    # curl: JSON header included
alias cjg='curl -sS -H "Content-Type: application/json" -XGET'   # curl: JSON GET
alias cjp='curl -sS -H "Content-Type: application/json" -XPOST'  # curl: JSON POST
alias cju='curl -sS -H "Content-Type: application/json" -XPUT'   # curl: JSON PUT
alias cjd='curl -sS -H "Content-Type: application/json" -XDELETE'# curl: JSON DELETE
alias cjh='curl -I'                                         # curl: fetch only HTTP headers
alias cjl='curl -sS -L'                                     # curl: follow redirects
alias cjo='curl -sS -o'                                     # curl: write output to file (usage: cjo FILE URL)

# ====================
# SSH
# ====================
alias sshgen='ssh-keygen -t rsa -b 4096 -C'       # generate a new RSA 4096-bit key (usage: sshgen "email@example.com")
alias sshed='eval "$(ssh-agent -s)"'              # start ssh-agent
alias sshadd='ssh-add ~/.ssh/id_rsa'              # add the default private key to ssh-agent
alias sshpub='cat ~/.ssh/id_rsa.pub'              # show the public key
alias sshls='ls -al ~/.ssh'                       # list ssh keys in ~/.ssh
alias sshcopy='pbcopy < ~/.ssh/id_rsa.pub'        # copy public key to clipboard (macOS)
alias sshcopylinux='xclip -sel clip < ~/.ssh/id_rsa.pub'  # copy public key to clipboard (Linux)

