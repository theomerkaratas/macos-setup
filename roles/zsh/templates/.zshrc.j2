# ====================
alias k='kubectl'                                     # shortcut for kubectl
alias kctx='kubectl config use-context'               # switch cluster context
alias kns='kubectl config set-context --current --namespace' # switch namespace
alias kg='kubectl get'                                # get resources
alias kd='kubectl describe'                           # describe resource details
alias ka='kubectl apply -f'                           # apply manifest file
alias kdel='kubectl delete -f'                        # delete manifest file
alias kl='kubectl logs -f'                            # follow logs of a pod
alias kex='kubectl exec -it'                          # exec into a pod
alias kevents='kubectl get events --sort-by=.metadata.creationTimestamp' # get events ordered by time
