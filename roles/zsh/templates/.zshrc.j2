# ====================
# Docker CLI
# ====================
alias dc='docker container'                          # shortcut for docker container commands
alias dcr='docker create'                            # create a new container
alias mac_plat='--platform=linux/arm64'              # platform flag for ARM64 images (Mac M1/M2)
alias di='docker image'                              # shortcut for docker image commands
alias dih='docker image history'                     # show image history
alias dii='docker image inspect'                     # inspect an image
alias de='docker exec -it'                           # exec into a running container
alias db='docker build'                              # build an image
alias db_see_out_no_cc='docker build --no-cache --progress=plain'  # build without cache, see full output
alias ds='docker start -a'                           # start a container and attach
alias dst='docker stop'                              # stop a container
alias dk='docker kill'                               # kill a container
alias dl='docker logs'                               # view container logs
alias dv='docker volume'                             # shortcut for docker volume commands
alias dr='docker run'                                # run a new container
alias dr_arm='docker container run -d --platform=linux/arm64' # run container detached on ARM64
alias dn='docker network'                            # shortcut for docker network commands
alias dt='docker image tag'                          # tag an image
alias dp='docker push'                               # push an image to registry
alias ddel_all='docker system prune'                 # remove all unused data
alias dps='docker ps'                                # list running containers
alias dpsa='docker ps -a'                            # list all containers (including stopped)
alias dimg='docker images'                           # list all images
alias dtop='docker top'                              # display running processes of a container
alias dins='docker inspect'                          # inspect a container

# ====================
# Docker Compose
# ====================
alias dco='docker compose'                           # shortcut for docker compose
alias dcou='docker compose up'                       # start services (foreground)
alias dcoud='docker compose up -d'                   # start services in detached mode
alias dcod='docker compose down'                     # stop and remove containers
alias dcol='docker compose logs -f'                  # follow logs from compose services
alias dcor='docker compose restart'                  # restart services

