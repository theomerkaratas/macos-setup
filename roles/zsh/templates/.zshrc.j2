alias kgs='kubectl get svc'                           # list services
alias kgd='kubectl get deployments'                   # list deployments
alias kgn='kubectl get nodes'                         # list nodes
alias kgc='kubectl get configmaps'                    # list configmaps
alias kgsec='kubectl get secrets'                     # list secrets
alias kpf='kubectl port-forward'                      # port forward from pod/service
alias krm='kubectl rollout restart'                   # restart deployment
alias krs='kubectl rollout status'                    # check rollout status
alias ktop='kubectl top pods'                         # show pod resource usage
alias ktopn='kubectl top nodes'                       # show node resource usage
alias kyaml='kubectl get -o yaml'                     # get resources as yaml
alias kjson='kubectl get -o json'                     # get resources as json

